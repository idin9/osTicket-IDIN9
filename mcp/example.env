# osTicket MCP server configuration
# Copy to mcp/.env and fill in real values.

# Base URL of the osTicket installation (no trailing /api)
OS_TICKET_BASE_URL=https://supportdesk.in.th/idin9

# API key created under Admin Panel -> Manage -> API Keys
# Permissions needed per tool group:
#   create_ticket      -> Can Create Tickets
#   read/list          -> Can Read Tickets  (KB read ALSO allowed via Can Read Knowledge Base)
#   update/reply/note  -> Can Update Tickets + Mapped Staff
#   merge              -> Can Update Tickets + Mapped Staff
#   run_cron           -> Can Execute Cron
#   KB write           -> Can Manage Knowledge Base + Mapped Staff
OS_TICKET_API_KEY=

# Transport: streamable-http | sse | stdio
MCP_TRANSPORT=streamable-http

# Bind address/port (streamable-http)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Paths (optional)
MCP_STREAMABLE_HTTP_PATH=/mcp
MCP_SSE_PATH=/sse
MCP_SSE_MESSAGE_PATH=/messages/

# HTTP timeout for API calls (seconds)
OS_TICKET_TIMEOUT=30